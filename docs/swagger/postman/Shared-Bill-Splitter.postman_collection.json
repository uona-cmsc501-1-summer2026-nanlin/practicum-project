            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Casey\",\n  \"email\": \"casey@example.com\"\n}" },
            "url": "{{baseUrl}}/people"
          }
        },
        {
          "name": "Create group",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                "const data = (pm.response.json().data || pm.response.json());",
                "pm.collectionVariables.set('groupId', String(data.id));"
              ],
              "type": "text/javascript"
            }
          }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"July trip\",\n  \"currency\": \"USD\"\n}" },
            "url": "{{baseUrl}}/groups"
          }
        },
        {
          "name": "Add member — Alex",
          "event": [{
            "listen": "test",
            "script": {
              "exec": ["pm.test('Status is 201', () => pm.response.to.have.status(201));"],
              "type": "text/javascript"
            }
          }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"userId\": {{personId1}}\n}" },
            "url": "{{baseUrl}}/groups/{{groupId}}/members"
          }
        },
        {
          "name": "Add member — Sam",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"userId\": {{personId2}}\n}" },
            "url": "{{baseUrl}}/groups/{{groupId}}/members"
          }
        },
        {
          "name": "Add member — Jordan",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"userId\": {{personId3}}\n}" },
            "url": "{{baseUrl}}/groups/{{groupId}}/members"
          }
        },
        {
          "name": "Add member — Riley",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"userId\": {{personId4}}\n}" },
            "url": "{{baseUrl}}/groups/{{groupId}}/members"
          }
        },
        {
          "name": "Add member — Casey",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"userId\": {{personId5}}\n}" },
            "url": "{{baseUrl}}/groups/{{groupId}}/members"
          }
        },
        {
          "name": "Add charge — Dinner $90 (all 5)",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                "const data = (pm.response.json().data || pm.response.json());",
                "pm.collectionVariables.set('chargeId', String(data.id));",
                "pm.test('Share is $18', () => pm.expect(data.sharePerPerson).to.eql(18));"
              ],
              "type": "text/javascript"
            }
          }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"description\": \"Dinner\",\n  \"amount\": 90,\n  \"paidByUserId\": {{personId1}},\n  \"participantIds\": [{{personId1}}, {{personId2}}, {{personId3}}, {{personId4}}, {{personId5}}],\n  \"splitRule\": \"equal\"\n}"
            },
            "url": "{{baseUrl}}/groups/{{groupId}}/charges",
            "description": "Alex paid $90; split equally among all five → $18 each."
          }
        },
        {
          "name": "Add charge — Groceries $60 (Alex, Sam, Jordan)",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                "const data = (pm.response.json().data || pm.response.json());",
                "pm.collectionVariables.set('chargeId2', String(data.id));",
                "pm.test('Share is $20', () => pm.expect(data.sharePerPerson).to.eql(20));"
              ],
              "type": "text/javascript"
            }
          }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"description\": \"Groceries\",\n  \"amount\": 60,\n  \"paidByUserId\": {{personId2}},\n  \"participantIds\": [{{personId1}}, {{personId2}}, {{personId3}}],\n  \"splitRule\": \"equal\"\n}"
            },
            "url": "{{baseUrl}}/groups/{{groupId}}/charges"
          }
        },
        {
          "name": "Add charge — Uber $40 (Sam, Casey)",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                "const data = (pm.response.json().data || pm.response.json());",
                "pm.collectionVariables.set('chargeId3', String(data.id));",
                "pm.test('Share is $20', () => pm.expect(data.sharePerPerson).to.eql(20));"
              ],
              "type": "text/javascript"
            }
          }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"description\": \"Uber\",\n  \"amount\": 40,\n  \"paidByUserId\": {{personId5}},\n  \"participantIds\": [{{personId2}}, {{personId5}}],\n  \"splitRule\": \"equal\"\n}"
            },
            "url": "{{baseUrl}}/groups/{{groupId}}/charges"
          }
        },
        {
          "name": "Add charge — Camping gear $75 (Jordan, Riley, Casey)",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                "const data = (pm.response.json().data || pm.response.json());",
                "pm.collectionVariables.set('chargeId4', String(data.id));",
                "pm.test('Share is $25', () => pm.expect(data.sharePerPerson).to.eql(25));"
              ],
              "type": "text/javascript"
            }
          }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"description\": \"Camping gear\",\n  \"amount\": 75,\n  \"paidByUserId\": {{personId3}},\n  \"participantIds\": [{{personId3}}, {{personId4}}, {{personId5}}],\n  \"splitRule\": \"equal\"\n}"
            },
            "url": "{{baseUrl}}/groups/{{groupId}}/charges"
          }
        },
        {
          "name": "List all charges",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                "const data = (pm.response.json().data || pm.response.json());",
                "pm.test('Four charges', () => pm.expect(data).to.have.lengthOf(4));"
              ],
              "type": "text/javascript"
            }
          }],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/groups/{{groupId}}/charges"
          }
        },
        {
          "name": "Settle",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                "const data = (pm.response.json().data || pm.response.json());",
                "pm.test('Five balances', () => pm.expect(data.balances).to.have.lengthOf(5));",
                "pm.test('Alex net +52', () => {",
                "  const alex = data.balances.find(b => b.name === 'Alex');",
                "  pm.expect(alex.net).to.eql(52);",
                "});",
                "pm.test('Riley net -43', () => {",
                "  const riley = data.balances.find(b => b.name === 'Riley');",
                "  pm.expect(riley.net).to.eql(-43);",
                "});",
                "pm.test('Four transfers', () => pm.expect(data.transfers).to.have.lengthOf(4));"
              ],
              "type": "text/javascript"
            }
          }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{}" },
            "url": "{{baseUrl}}/groups/{{groupId}}/settle",
            "description": "Expected balances: Alex +52, Sam +2, Jordan +12, Riley -43, Casey -23."
          }
        },
        {
          "name": "Filter charges (minAmount=50)",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                "const data = (pm.response.json().data || pm.response.json());",
                "pm.test('Three charges >= 50', () => pm.expect(data).to.have.lengthOf(3));"
              ],
              "type": "text/javascript"
            }
          }],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/groups/{{groupId}}/charges?minAmount=50",
              "host": ["{{baseUrl}}"],
              "path": ["groups", "{{groupId}}", "charges"],
              "query": [{ "key": "minAmount", "value": "50" }]
            }
          }
        }
      ]
    },
    {
      "name": "2. Negative cases",
      "item": [
        {
          "name": "Charge with zero amount",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"description\": \"Bad charge\",\n  \"amount\": 0,\n  \"paidByUserId\": {{personId1}},\n  \"participantIds\": [{{personId1}}]\n}"
            },
            "url": "{{baseUrl}}/groups/{{groupId}}/charges"
          }
        },
        {
