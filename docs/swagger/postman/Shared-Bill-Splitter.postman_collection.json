    {
      "name": "1. Valid Demo Flow",
      "description": "Run these requests **in order**. Five people, four charges (some split among only a subset). Each create step saves ids into collection variables.",
      "item": [
        {
          "name": "Create group",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "const data = body.data || body;",
                  "pm.collectionVariables.set('groupId', String(data.id));",
                  "pm.test('Group has name', () => pm.expect(data.name).to.eql('July beach trip'));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"July beach trip\",\n  \"currency\": \"USD\"\n}"
            },
            "url": "{{baseUrl}}/groups",
            "description": "Creates a new group. Saves `groupId` to collection variables."
          },
          "response": []
        },
        {
          "name": "Add person — Alex",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "const data = body.data || body;",
                  "pm.collectionVariables.set('personId1', String(data.id));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Alex\",\n  \"email\": \"alex@example.com\"\n}"
            },
            "url": "{{baseUrl}}/groups/{{groupId}}/people"
          },
          "response": []
        },
