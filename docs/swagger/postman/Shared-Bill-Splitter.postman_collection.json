            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"description\": \"Bad charge\",\n  \"amount\": 10,\n  \"paidByUserId\": 999,\n  \"participantIds\": [{{personId1}}]\n}"
            },
            "url": "{{baseUrl}}/groups/{{groupId}}/charges"
          }
        },
        {
          "name": "Delete person still in group",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/people/{{personId1}}"
          }
