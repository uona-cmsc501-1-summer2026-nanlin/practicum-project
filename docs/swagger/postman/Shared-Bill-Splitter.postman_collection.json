{
  "info": {
    "_postman_id": "billsplitter-d3-2026",
    "name": "Split It API (D3)",
    "description": "CMSC501-1 practicum — Deliverable #3 demo collection.\n\n**Setup:** run `go run .` (or `make run`), wipe old SQLite if upgrading from D2 (`del billsplitter.db`), then import this file.\n\n**Flow:** create global people → create group → add members → charges → settle.\n\n**Tip:** run folder **1. Valid Demo Flow** top to bottom.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:55555/api/v1" },
    { "key": "groupId", "value": "1" },
    { "key": "personId1", "value": "1" },
    { "key": "personId2", "value": "2" },
    { "key": "personId3", "value": "3" },
    { "key": "personId4", "value": "4" },
    { "key": "personId5", "value": "5" },
    { "key": "chargeId", "value": "1" },
    { "key": "chargeId2", "value": "2" },
    { "key": "chargeId3", "value": "3" },
    { "key": "chargeId4", "value": "4" }
  ],
  "item": [
    {
      "name": "0. Reset (optional)",
      "item": [
        {
          "name": "Truncate all",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/internal/testing/truncate/all"
          }
        }
      ]
    },
    {
      "name": "1. Valid Demo Flow",
      "description": "Five people, one group, four charges (some split among a subset).",
      "item": [
        {
          "name": "Create person — Alex",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                "const data = (pm.response.json().data || pm.response.json());",
                "pm.collectionVariables.set('personId1', String(data.id));"
              ],
              "type": "text/javascript"
            }
          }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Alex\",\n  \"email\": \"alex@example.com\"\n}" },
            "url": "{{baseUrl}}/people"
          }
        },
        {
          "name": "Create person — Sam",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                "const data = (pm.response.json().data || pm.response.json());",
                "pm.collectionVariables.set('personId2', String(data.id));"
              ],
