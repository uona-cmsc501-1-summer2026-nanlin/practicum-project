          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Sam\",\n  \"email\": \"sam@example.com\"\n}" },
            "url": "{{baseUrl}}/people"
          }
