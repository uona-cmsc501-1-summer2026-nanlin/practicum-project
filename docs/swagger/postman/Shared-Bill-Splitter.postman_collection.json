                  "const body = pm.response.json();",
                  "const data = body.data || body;",
                  "pm.test('Four charges', () => pm.expect(data).to.have.lengthOf(4));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/groups/{{groupId}}/charges",
            "description": "Shows all four charges before settling."
          },
          "response": []
        },
        {
          "name": "Settle",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "const data = body.data || body;",
                  "pm.test('Five balances', () => pm.expect(data.balances).to.have.lengthOf(5));",
                  "pm.test('Alex net +52', () => {",
                  "  const alex = data.balances.find(b => b.name === 'Alex');",
                  "  pm.expect(alex.net).to.eql(52);",
                  "});",
                  "pm.test('Riley net -43', () => {",
                  "  const riley = data.balances.find(b => b.name === 'Riley');",
                  "  pm.expect(riley.net).to.eql(-43);",
                  "});",
                  "pm.test('Four transfers', () => pm.expect(data.transfers).to.have.lengthOf(4));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{}"
            },
            "url": "{{baseUrl}}/groups/{{groupId}}/settle",
            "description": "Expected balances: Alex +52, Sam +2, Jordan +12, Riley -43, Casey -23.\nTransfers: Riley→Alex $43, Casey→Alex $9, Casey→Sam $2, Casey→Jordan $12."
          },
          "response": []
        },
        {
          "name": "Filter charges (minAmount=50)",
          "event": [
